# Secret shared with CryptoPilot AI backend (WEBHOOK_SECRET).
# Configure this variable in Railway; never commit its real value.
CRYPTOPILOT_WEBHOOK_SECRET=replace-with-production-secret

# Canal gratuito de Onza Futures.
# FREE_CHANNEL_ID debe ser el ID numerico del canal (normalmente empieza por -100).
FREE_CHANNEL_ID=
# Semana operativa: lunes a domingo, hora de Colombia.
FREE_SIGNALS_PER_WEEK=3
FREE_ACCOUNT_BALANCE=10000
FREE_MARGIN_PER_TRADE=500
# Si se omite, se deriva de IMAGE_SERVER_URL cambiando la ruta.
BITUNIX_IMAGE_SERVER_URL=
