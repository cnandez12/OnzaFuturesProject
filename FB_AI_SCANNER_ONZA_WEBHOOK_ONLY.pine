        else if not useWebhookJSON
            alert("🏆 TP3 ALCANZADO\n━━━━━━━━━━━━━━━━━━━━━━━━\n📊 " + syminfo.ticker + " | " + tfFormatted + " | SHORT\n💰 Ganancia: +" + str.tostring(roi_profit, "#.##") + "% ROI\n📍 Precio: " + formatPrice(tp3_y_short) + "\n━━━━━━━━━━━━━━━━━━━━━━━━\n⚡ FB AI CRYPTOFUTURES SCANNER", alert.freq_once_per_bar)
        tp3_alerted := true
    if sl_short_hit and not sl_alerted
