        roi_loss = calcROI(loss_pct, leverage)
        if useWebhookJSON and sendWebhookSL
            alert(buildEventJSON("sl", "SHORT", stored_entry, stop_y, -roi_loss, leverage, current_signalId), alert.freq_once_per_bar)
        else if not useWebhookJSON
            alert("❌ STOP LOSS ALCANZADO\n━━━━━━━━━━━━━━━━━━━━━━━━\n📊 " + syminfo.ticker + " | " + tfFormatted + " | SHORT\n💸 Pérdida: −" + str.tostring(roi_loss, "#.##") + "% ROI\n📍 Precio: " + formatPrice(stop_y) + "\n━━━━━━━━━━━━━━━━━━━━━━━━\n⚡ FB AI CRYPTOFUTURES SCANNER", alert.freq_once_per_bar)
        sl_alerted := true

// --------------------------------------------------------------------------------------------------------------------
// FIX BUG 2: Variables de DISPLAY para el panel — calculadas en tiempo real cada barra
// sin tocar las variables persistentes (winning_signals, account_balance, etc.)
// Incluyen la señal actualmente abierta para que el panel siempre muestre datos frescos
// --------------------------------------------------------------------------------------------------------------------

int   disp_winning  = winning_signals
int   disp_losing   = losing_signals
float disp_roi_won  = total_roi_won
float disp_roi_lost = total_roi_lost
float disp_balance  = account_balance

if last_signal_type == 1 and stored_entry != 0
    if tp1_long_hit or tp2_long_hit or tp3_long_hit
        // Señal ganadora con TP alcanzado
        if tp3_long_hit and useTP3
            float _p = math.abs(calcPercentage(stored_tp3_long, stored_entry))
            float _r = calcROI(_p, leverage)
            disp_winning  += 1
            disp_roi_won  += _r
            disp_balance  += risk_amount_per_trade * (_r / 100)
        else if tp2_long_hit and useTP2
            float _p = math.abs(calcPercentage(stored_tp2_long, stored_entry))
            float _r = calcROI(_p, leverage)
            disp_winning  += 1
            disp_roi_won  += _r
            disp_balance  += risk_amount_per_trade * (_r / 100)
        else if tp1_long_hit and useTP1
            float _p = math.abs(calcPercentage(stored_tp1_long, stored_entry))
            float _r = calcROI(_p, leverage)
            disp_winning  += 1
            disp_roi_won  += _r
            disp_balance  += risk_amount_per_trade * (_r / 100)
    else if sl_long_hit
        // SL puro
        float _p = math.abs(calcPercentage(stored_stop, stored_entry))
        float _r = calcROI(_p, leverage)
        disp_losing   += 1
        disp_roi_lost += _r
        disp_balance  -= risk_amount_per_trade
    else if not signal_closed_long
        // Señal flotante (sin TP ni SL formales aún)
        float _fpct = calcPercentage(close, stored_entry)
        float _froi = calcROI(_fpct, leverage)
        if _fpct > 0
            disp_winning  += 1
            disp_roi_won  += math.abs(_froi)
            disp_balance  += risk_amount_per_trade * (math.abs(_froi) / 100)
        else if _fpct < 0
            disp_losing   += 1
            disp_roi_lost += math.abs(_froi)
            disp_balance  -= risk_amount_per_trade * (math.abs(_froi) / 100)

else if last_signal_type == -1 and stored_entry != 0
    if tp1_short_hit or tp2_short_hit or tp3_short_hit
        // Señal ganadora con TP alcanzado
        if tp3_short_hit and useTP3
            float _p = math.abs(calcPercentage(stored_tp3_short, stored_entry))
            float _r = calcROI(_p, leverage)
            disp_winning  += 1
            disp_roi_won  += _r
            disp_balance  += risk_amount_per_trade * (_r / 100)
        else if tp2_short_hit and useTP2
            float _p = math.abs(calcPercentage(stored_tp2_short, stored_entry))
            float _r = calcROI(_p, leverage)
            disp_winning  += 1
            disp_roi_won  += _r
            disp_balance  += risk_amount_per_trade * (_r / 100)
        else if tp1_short_hit and useTP1
            float _p = math.abs(calcPercentage(stored_tp1_short, stored_entry))
            float _r = calcROI(_p, leverage)
            disp_winning  += 1
            disp_roi_won  += _r
            disp_balance  += risk_amount_per_trade * (_r / 100)
    else if sl_short_hit
        // SL puro
        float _p = math.abs(calcPercentage(stored_stop, stored_entry))
        float _r = calcROI(_p, leverage)
        disp_losing   += 1
        disp_roi_lost += _r
        disp_balance  -= risk_amount_per_trade
    else if not signal_closed_short
        // Señal flotante (sin TP ni SL formales aún)
        float _fpct = calcPercentage(stored_entry, close)
        float _froi = calcROI(_fpct, leverage)
        if _fpct > 0
            disp_winning  += 1
            disp_roi_won  += math.abs(_froi)
            disp_balance  += risk_amount_per_trade * (math.abs(_froi) / 100)
        else if _fpct < 0
            disp_losing   += 1
            disp_roi_lost += math.abs(_froi)
            disp_balance  -= risk_amount_per_trade * (math.abs(_froi) / 100)

// --------------------------------------------------------------------------------------------------------------------
// PANEL ESTADÍSTICO
// --------------------------------------------------------------------------------------------------------------------

// ── FIX BUG 1 + FIX BUG 2: fórmulas usan variables de display ────────────────
// win_rate denominador = señales CERRADAS (disp_winning + disp_losing)
// todos los valores del panel usan disp_* para incluir señal activa
int   disp_closed_count = disp_winning + disp_losing
win_rate       = disp_closed_count > 0 ? (disp_winning / disp_closed_count) * 100 : 0.0
net_roi        = disp_roi_won - disp_roi_lost
avg_win        = disp_winning > 0 ? disp_roi_won / disp_winning : 0.0
avg_loss       = disp_losing  > 0 ? disp_roi_lost / disp_losing  : 0.0
net_profit_usd = disp_balance - accountSize
start_date_str = first_signal_time != 0 ? str.format("{0,date,MMM dd, yyyy}", first_signal_time) : "No signals yet"

if showPanel
    int numRows = panelExpanded ? 9 : 2
    var table statsTable = table.new(position.top_right, 8, numRows, border_width=1, border_color=color.new(#000000, 70), frame_width=2, frame_color=color.new(#FFD700, 50))

    if barstate.islast
        table.cell(statsTable, 0, 0, panelExpanded ? "▼" : "▶", text_color=color.new(#FFD700, 0), bgcolor=color.new(#000000, 10), text_size=size.small, text_halign=text.align_center)
        table.cell(statsTable, 1, 0, "FB CRYPTOFUTURES", text_color=color.new(#FFD700, 0), bgcolor=color.new(#000000, 10), text_size=size.normal, text_halign=text.align_left)
        table.merge_cells(statsTable, 1, 0, 5, 0)
        table.cell(statsTable, 6, 0, str.tostring(leverage) + "x", text_color=color.new(#00E5FF, 0), bgcolor=color.new(#000000, 10), text_size=size.normal, text_halign=text.align_center)
        table.cell(statsTable, 7, 0, tfFormatted, text_color=color.new(#757575, 0), bgcolor=color.new(#000000, 10), text_size=size.small, text_halign=text.align_center)

        if panelExpanded
            // ── FIX BUG 2: balance y colores usan disp_balance ───────────────
            color balanceColor = disp_balance > accountSize ? color.new(#00E676, 0) : disp_balance < accountSize ? color.new(#FF5252, 0) : color.white
            color balanceBg    = disp_balance > accountSize ? color.new(#004D40, 0) : disp_balance < accountSize ? color.new(#B71C1C, 0) : color.new(#424242, 0)
            string balanceSign = net_profit_usd > 0 ? "+" : ""

            table.cell(statsTable, 0, 1, "💼", text_color=color.new(#00E5FF, 0), bgcolor=color.new(#000000, 10), text_size=size.small, text_halign=text.align_center)
            table.cell(statsTable, 1, 1, "Balance", text_color=color.new(#00E5FF, 0), bgcolor=color.new(#000000, 10), text_size=size.normal, text_halign=text.align_left)
            // ── FIX BUG 2: muestra disp_balance ─────────────────────────────
            table.cell(statsTable, 2, 1, "$" + str.tostring(disp_balance, "#.##"), text_color=balanceColor, bgcolor=balanceBg, text_size=size.large, text_halign=text.align_center)
            table.merge_cells(statsTable, 2, 1, 4, 1)
            table.cell(statsTable, 5, 1, balanceSign + "$" + str.tostring(net_profit_usd, "#.##"), text_color=balanceColor, bgcolor=color.new(#263238, 0), text_size=size.small, text_halign=text.align_center)
            table.merge_cells(statsTable, 5, 1, 7, 1)

            table.cell(statsTable, 0, 2, "⚠️", text_color=color.new(#FF9800, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_center)
            table.cell(statsTable, 1, 2, "Max DD", text_color=color.new(#FF9800, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_left)
            table.cell(statsTable, 2, 2, str.tostring(max_drawdown_pct, "#.##") + "%", text_color=color.new(#FF5252, 0), bgcolor=color.new(#B71C1C, 30), text_size=size.normal, text_halign=text.align_center)
            table.cell(statsTable, 3, 2, "(-$" + str.tostring(max_drawdown_usd, "#.##") + ")", text_color=color.new(#FF5252, 0), bgcolor=color.new(#263238, 0), text_size=size.tiny, text_halign=text.align_center)
            table.merge_cells(statsTable, 3, 2, 4, 2)
            table.cell(statsTable, 5, 2, "📅", text_color=color.new(#64B5F6, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_center)
            table.cell(statsTable, 6, 2, start_date_str, text_color=color.new(#64B5F6, 0), bgcolor=color.new(#263238, 0), text_size=size.tiny, text_halign=text.align_center)
            table.merge_cells(statsTable, 6, 2, 7, 2)

            table.cell(statsTable, 0, 3, "📊", text_color=color.new(#FFD700, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_center)
            table.cell(statsTable, 1, 3, str.tostring(total_signals) + " Signals", text_color=color.white, bgcolor=color.new(#263238, 0), text_size=size.normal, text_halign=text.align_left)
            table.merge_cells(statsTable, 1, 3, 2, 3)
            table.cell(statsTable, 3, 3, "Win Rate", text_color=color.new(#BDBDBD, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_center)
            color wrColor = win_rate >= 70 ? color.new(#00E676, 0) : win_rate >= 50 ? color.new(#FFD740, 0) : color.new(#FF5252, 0)
            color wrBg    = win_rate >= 70 ? color.new(#1B5E20, 50) : win_rate >= 50 ? color.new(#F57F17, 50) : color.new(#B71C1C, 50)
            table.cell(statsTable, 4, 3, str.tostring(win_rate, "#.#") + "%", text_color=wrColor, bgcolor=wrBg, text_size=size.large, text_halign=text.align_center)
            table.merge_cells(statsTable, 4, 3, 7, 3)

            int activeTPCount = 0
            if useTP1
                activeTPCount += 1
            if useTP2
                activeTPCount += 1
            if useTP3
                activeTPCount += 1
            int currentCol = 0
            if useTP1
                table.cell(statsTable, currentCol, 4, "TP1: " + str.tostring(tp1_count), text_color=GREEN_PROFIT, bgcolor=color.new(#263238, 0), text_size=size.small, text_halign=text.align_center)
                table.merge_cells(statsTable, currentCol, 4, currentCol + 1, 4)
                currentCol += 2
            if useTP2
                table.cell(statsTable, currentCol, 4, "TP2: " + str.tostring(tp2_count), text_color=GREEN_DARK, bgcolor=color.new(#263238, 0), text_size=size.small, text_halign=text.align_center)
                table.merge_cells(statsTable, currentCol, 4, currentCol + 1, 4)
                currentCol += 2
            if useTP3
                table.cell(statsTable, currentCol, 4, "TP3: " + str.tostring(tp3_count), text_color=GOLD_TP, bgcolor=color.new(#263238, 0), text_size=size.small, text_halign=text.align_center)
                table.merge_cells(statsTable, currentCol, 4, currentCol + 1, 4)
                currentCol += 2
            table.cell(statsTable, currentCol, 4, "SL: " + str.tostring(sl_count), text_color=RED_LOSS, bgcolor=color.new(#263238, 0), text_size=size.small, text_halign=text.align_center)
            table.merge_cells(statsTable, currentCol, 4, 7, 4)

            table.cell(statsTable, 0, 5, "✅", text_color=color.new(#00E676, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_center)
            // ── FIX BUG 2: muestra disp_winning / disp_losing ───────────────
            table.cell(statsTable, 1, 5, str.tostring(disp_winning) + "W", text_color=color.new(#00E676, 0), bgcolor=color.new(#1B5E20, 30), text_size=size.normal, text_halign=text.align_center)
            table.cell(statsTable, 2, 5, "+" + str.tostring(avg_win, "#.##") + "%", text_color=color.new(#00E676, 0), bgcolor=color.new(#1B5E20, 30), text_size=size.small, text_halign=text.align_center)
            table.merge_cells(statsTable, 2, 5, 3, 5)
            table.cell(statsTable, 4, 5, "❌", text_color=color.new(#FF5252, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_center)
            table.cell(statsTable, 5, 5, str.tostring(disp_losing) + "L", text_color=color.new(#FF5252, 0), bgcolor=color.new(#B71C1C, 30), text_size=size.normal, text_halign=text.align_center)
            table.cell(statsTable, 6, 5, "-" + str.tostring(avg_loss, "#.##") + "%", text_color=color.new(#FF5252, 0), bgcolor=color.new(#B71C1C, 30), text_size=size.small, text_halign=text.align_center)
            table.merge_cells(statsTable, 6, 5, 7, 5)

            table.cell(statsTable, 0, 6, "", bgcolor=color.new(#FFD700, 10), text_size=size.tiny)
            table.merge_cells(statsTable, 0, 6, 7, 6)

            color netColor = net_roi > 0 ? color.new(#00E676, 0) : net_roi < 0 ? color.new(#FF5252, 0) : color.new(#FFD740, 0)
            color netBg    = net_roi > 0 ? color.new(#004D40, 0) : net_roi < 0 ? color.new(#B71C1C, 0) : color.new(#424242, 0)
            string netSign = net_roi > 0 ? "+" : ""
            table.cell(statsTable, 0, 7, "🎯", text_color=color.new(#FFD700, 0), bgcolor=color.new(#000000, 10), text_size=size.normal, text_halign=text.align_center)
            table.cell(statsTable, 1, 7, "NET ROI", text_color=color.new(#FFD700, 0), bgcolor=color.new(#000000, 10), text_size=size.large, text_halign=text.align_left)
            table.cell(statsTable, 2, 7, netSign + str.tostring(net_roi, "#.##") + "%", text_color=netColor, bgcolor=netBg, text_size=size.huge, text_halign=text.align_center)
            table.merge_cells(statsTable, 2, 7, 7, 7)

        else
            color netColor = net_roi > 0 ? color.new(#00E676, 0) : net_roi < 0 ? color.new(#FF5252, 0) : color.new(#FFD740, 0)
            color netBg    = net_roi > 0 ? color.new(#004D40, 0) : net_roi < 0 ? color.new(#B71C1C, 0) : color.new(#424242, 0)
            string netSign = net_roi > 0 ? "+" : ""
            table.cell(statsTable, 0, 1, "🎯", text_color=color.new(#FFD700, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_center)
            table.cell(statsTable, 1, 1, "NET", text_color=color.new(#FFD740, 0), bgcolor=color.new(#1a1a1a, 20), text_size=size.small, text_halign=text.align_left)
            table.cell(statsTable, 2, 1, netSign + str.tostring(net_roi, "#.##") + "%", text_color=netColor, bgcolor=netBg, text_size=size.huge, text_halign=text.align_center)
            table.merge_cells(statsTable, 2, 1, 5, 1)
            table.cell(statsTable, 6, 1, str.tostring(win_rate, "#") + "%", text_color=color.new(#00E5FF, 0), bgcolor=color.new(#263238, 0), text_size=size.normal, text_halign=text.align_center)
            table.cell(statsTable, 7, 1, str.tostring(total_signals), text_color=color.new(#BDBDBD, 0), bgcolor=color.new(#263238, 0), text_size=size.small, text_halign=text.align_center)
