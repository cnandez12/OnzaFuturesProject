//@version=5
indicator("FB AI SCANNER + ONZA FUTURES | RELAY v1", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=350, max_bars_back=5000)

// --------------------------------------------------------------------------------------------------------------------
// INPUTS VISIBLES PARA EL USUARIO
// --------------------------------------------------------------------------------------------------------------------

var g_leverage = '⚡ Configuración de Futuros'
leverage = input.int(20, "Apalancamiento", minval=1, maxval=125, group=g_leverage, tooltip="Apalancamiento a utilizar en el trade")
riskPercent = input.float(2.0, "Riesgo por Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=g_leverage, tooltip="Porcentaje del capital a arriesgar por operación")
accountSize = input.float(1000.0, "Tamaño de Cuenta ($)", minval=100, group=g_leverage, tooltip="Capital total disponible para trading")

var g_risk = '🛡️ Gestión de Stop Loss'
atrMultiplier = input.float(1.8, "ATR Multiplier", minval=1.0, maxval=5.0, step=0.1, group=g_risk, tooltip="Multiplicador del ATR para calcular Stop Loss (menor = SL más ajustado)")

var g_targets = '🎯 Take Profits'
useTP1 = input.bool(true, "Activar TP1", group=g_targets, inline="tp1")
multTP1 = input.float(0.5, "TP1 Multiplicador", minval=0.3, maxval=2.0, step=0.1, group=g_targets, inline="tp1")
useTP2 = input.bool(true, "Activar TP2", group=g_targets, inline="tp2")
multTP2 = input.float(1.5, "TP2 Multiplicador", minval=0.5, maxval=3.0, step=0.1, group=g_targets, inline="tp2")
useTP3 = input.bool(true, "Activar TP3", group=g_targets, inline="tp3")
multTP3 = input.float(3.0, "TP3 Multiplicador", minval=1.0, maxval=5.0, step=0.1, group=g_targets, inline="tp3")

var g_filters = '🔍 Filtros de Señal'
useVolumeFilter = input.bool(true, "Activar Filtro de Volumen", group=g_filters, tooltip="Solo genera señales cuando el volumen supera 120% del promedio")
volumeMA = input.int(20, "Período MA de Volumen", minval=5, maxval=100, group=g_filters)
useTimeFilter = input.bool(false, "Activar Filtro de Horarios", group=g_filters)
startHour = input.int(0, "Hora Inicio (UTC)", minval=0, maxval=23, group=g_filters)
endHour = input.int(23, "Hora Fin (UTC)", minval=0, maxval=23, group=g_filters)

var g_panel = '📊 Panel Estadístico'
showPanel = input.bool(true, "Mostrar Panel", group=g_panel)
panelExpanded = input.bool(true, "Panel Expandido por Defecto", group=g_panel)

var g_realtime = '📈 P&L en Tiempo Real'
showRealtimePnL = input.bool(true, "Mostrar P&L en Tiempo Real", group=g_realtime, tooltip="Muestra el rendimiento actual de la posición activa cerca del precio")

var g_close_labels = '🔄 Etiquetas de Cierre'
showCloseLabels = input.bool(true, "Mostrar Etiquetas de Cierre de Señal", group=g_close_labels, tooltip="Muestra labels rosados cuando se cierra una señal por cambio de dirección")

var g_visual = '🎨 Estilo Visual'
showZoneBackground = input.bool(true, "Mostrar Zonas con Fondo", group=g_visual, tooltip="Muestra zonas de color para TPs (verde) y SL (rojo)")

var g_alerts = '🔔 Configuración de Alertas'
sendCloseAlerts = input.bool(true, "Enviar Alertas de Cierre por Señal Opuesta", group=g_alerts, tooltip="Envía alertas cuando una posición se cierra por cambio de tendencia")

var g_webhook = '🌐 Webhook JSON (API)'
useWebhookJSON = input.bool(true, "Activar Webhook JSON", group=g_webhook, tooltip="Envía las señales en formato JSON al endpoint configurado en TradingView")
webhookApiKey = input.string("", "API Key", group=g_webhook, tooltip="API Key para autenticación con el endpoint")
sendWebhookTP = input.bool(true, "Enviar TP Alcanzados vía Webhook", group=g_webhook, tooltip="Envía notificación JSON cuando se alcanza un Take Profit")
sendWebhookSL = input.bool(true, "Enviar SL Alcanzado vía Webhook", group=g_webhook, tooltip="Envía notificación JSON cuando se alcanza el Stop Loss")
sendWebhookClose = input.bool(true, "Enviar Cierre de Señal vía Webhook", group=g_webhook, tooltip="Envía notificación JSON cuando una señal se cierra por cambio de dirección")

// El contrato Onza de este proyecto requiere los tres TP, en orden.
if barstate.isfirst and useWebhookJSON
    if not (useTP1 and useTP2 and useTP3)
        runtime.error("Webhook Onza: TP1, TP2 y TP3 deben estar activos.")
    if not (multTP1 < multTP2 and multTP2 < multTP3)
        runtime.error("Webhook Onza: los multiplicadores deben cumplir TP1 < TP2 < TP3.")

// --------------------------------------------------------------------------------------------------------------------
// CONFIGURACIÓN INTERNA
// --------------------------------------------------------------------------------------------------------------------

showSignals = true
strategy_type = "Normal"
sensitivity = 5.0
consSignalsFilter = true
StrongSignalsOnly = true
enableTpSlAreas = true
tpLabels = true
green1 = #00ffbb
red1 = #ff1100

color GREEN_PROFIT = #00E676
color GREEN_DARK = #00C853
color GREEN_BG = #1B5E20
color RED_LOSS = #FF5252
color RED_DARK = #D32F2F
color RED_BG = #B71C1C
color GOLD_TP = #FFD700

// --------------------------------------------------------------------------------------------------------------------
// FUNCIONES
// --------------------------------------------------------------------------------------------------------------------

supertrend(src, factor, atrLen) =>
    atrValue = ta.atr(atrLen)
    upperBand = src + factor * atrValue
    lowerBand = src - factor * atrValue
    prevLowerBand = nz(lowerBand[1])
    prevUpperBand = nz(upperBand[1])
    lowerBand := lowerBand > prevLowerBand or close[1] < prevLowerBand ? lowerBand : prevLowerBand
    upperBand := upperBand < prevUpperBand or close[1] > prevUpperBand ? upperBand : prevUpperBand
    int direction = na
    float superTrend = na
    prevSuperTrend = superTrend[1]
    if prevSuperTrend == prevUpperBand
        direction := close > upperBand ? 1 : -1
    else
        direction := close < lowerBand ? -1 : 1
    superTrend := direction == 1 ? lowerBand : direction == -1 ? upperBand : na
    [superTrend, direction]

calcPercentage(target_price, entry_price) =>
    ((target_price - entry_price) / entry_price) * 100

calcPositionSize(entry, stop, risk_pct, lev, account) =>
    risk_amount = account * (risk_pct / 100)
    stop_distance = math.abs(entry - stop)
    stop_percent = (stop_distance / entry) * 100
    position_size = (risk_amount / stop_percent) * lev
    position_size

calcROI(profit_percent, lev) =>
    profit_percent * lev

formatTimeframe() =>
    string tf = timeframe.period
    string result = ""
    if timeframe.isseconds
        result := tf + "S"
    else if timeframe.isminutes
        int mins = int(str.tonumber(tf))
        if mins >= 60
            int hours = mins / 60
            result := str.tostring(hours) + "H"
        else
            result := tf + "M"
    else if timeframe.isdaily
        result := tf == "1" ? "D" : tf + "D"
    else if timeframe.isweekly
        result := tf == "1" ? "W" : tf + "W"
    else if timeframe.ismonthly
        result := tf == "1" ? "MN" : tf + "MN"
    else
        result := tf
    result

formatPrice(price) =>
    str.tostring(math.round_to_mintick(price))

// === FUNCIONES JSON WEBHOOK ===

onzaSymbol() =>
    string ticker = syminfo.ticker
    string symbol = ticker
    if str.endswith(ticker, "USDT.P")
        symbol := str.substring(ticker, 0, str.length(ticker) - 6) + "USD.P"
    else if str.endswith(ticker, "USDT")
        symbol := str.substring(ticker, 0, str.length(ticker) - 4) + "USD.P"
    else if str.endswith(ticker, "USD")
        symbol := ticker + ".P"
    symbol

onzaROI(direction, entryPrice, eventPrice) =>
    float ep = math.round_to_mintick(entryPrice)
    float ev = math.round_to_mintick(eventPrice)
    (direction == "LONG" ? ev - ep : ep - ev) / ep * 100 * leverage

generateSignalId() =>
    string sid = onzaSymbol() + "_" + formatTimeframe() + "_" + str.tostring(time)
    sid

buildEntryJSON(direction, entryPrice, slPrice, slRoi, tp1Price, tp1Roi, tp2Price, tp2Roi, tp3Price, tp3Roi, lev, signalId) =>
    string json = '{'
    json += '"signalId":"' + signalId + '",'
    json += '"typeSignal":"entry",'
    json += '"symbol":"' + onzaSymbol() + '",'
    json += '"sourceExchange":"' + syminfo.prefix + '",'
    json += '"direction":"' + direction + '",'
    json += '"entry":' + str.tostring(entryPrice, format.mintick) + ','
    json += '"leverage":' + str.tostring(lev) + ','
    json += '"stopLoss":{"price":' + str.tostring(slPrice, format.mintick) + ',"roi":' + str.tostring(slRoi, "0.00") + '},'
    json += '"takeProfits":['
    bool needsComma = false
    if useTP1
        json += '{"price":' + str.tostring(tp1Price, format.mintick) + ',"roi":' + str.tostring(tp1Roi, "0.00") + '}'
        needsComma := true
    if useTP2
        json += (needsComma ? ',' : '') + '{"price":' + str.tostring(tp2Price, format.mintick) + ',"roi":' + str.tostring(tp2Roi, "0.00") + '}'
        needsComma := true
    if useTP3
        json += (needsComma ? ',' : '') + '{"price":' + str.tostring(tp3Price, format.mintick) + ',"roi":' + str.tostring(tp3Roi, "0.00") + '}'
    json += '],'
    json += '"timeframe":"' + formatTimeframe() + '",'
    json += '"message":"ONZA AI CRYPTOFUTURES",'
    json += '"apiKey":"' + webhookApiKey + '"'
    json += '}'
    json

buildEventJSON(typeSignal, direction, entryPrice, eventPrice, roi, lev, signalId) =>
    string json = '{'
    json += '"signalId":"' + signalId + '",'
    json += '"typeSignal":"' + typeSignal + '",'
    json += '"symbol":"' + onzaSymbol() + '",'
    json += '"sourceExchange":"' + syminfo.prefix + '",'
    json += '"direction":"' + direction + '",'
    json += '"entry":' + str.tostring(entryPrice, format.mintick) + ','
    json += '"price":' + str.tostring(eventPrice, format.mintick) + ','
    json += '"roi":' + str.tostring(roi, "0.00") + ','
    json += '"leverage":' + str.tostring(lev) + ','
    json += '"timeframe":"' + formatTimeframe() + '",'
    json += '"message":"ONZA AI CRYPTOFUTURES",'
    json += '"apiKey":"' + webhookApiKey + '"'
    json += '}'
    json

// --------------------------------------------------------------------------------------------------------------------
// CÁLCULOS PRINCIPALES
// --------------------------------------------------------------------------------------------------------------------

atr14 = ta.atr(14)
ema150 = ta.ema(close, 150)
ema250 = ta.ema(close, 250)
[_, _, macd] = ta.macd(close, 12, 26, 9)
[supertrendValue, supertrendDir] = supertrend(ohlc4, sensitivity, 10)
[_, _, adx] = ta.dmi(14, 14)

consFilter = adx > 20
StrongFilter = ta.ema(close, 200)
none = close > 0

vol_ma = ta.sma(volume, volumeMA)
volumeFilter = volume > vol_ma * 1.2

currentHour = hour(time, "UTC")
timeFilter = currentHour >= startHour and currentHour <= endHour

bull = ta.crossover(close, supertrendValue) and
       (StrongSignalsOnly ? close > StrongFilter : none) and
       (consSignalsFilter ? consFilter : none) and
       (useVolumeFilter ? volumeFilter : true) and
       (useTimeFilter ? timeFilter : true)

bear = ta.crossunder(close, supertrendValue) and
       (StrongSignalsOnly ? close < StrongFilter : none) and
       (consSignalsFilter ? consFilter : none) and
       (useVolumeFilter ? volumeFilter : true) and
       (useTimeFilter ? timeFilter : true)

countBull = ta.barssince(bull)
countBear = ta.barssince(bear)
trigger = nz(countBull, bar_index) < nz(countBear, bar_index) ? 1 : 0

atrBand = atr14 * atrMultiplier
atrStop = trigger ? low - atrBand : high + atrBand
lastTrade(src) => ta.valuewhen(bull or bear, src, 0)
entry_y = lastTrade(close)
stop_y = lastTrade(atrStop)
tp1_y = (entry_y - lastTrade(atrStop)) * multTP1 + entry_y
tp2_y = (entry_y - lastTrade(atrStop)) * multTP2 + entry_y
tp3_y = (entry_y - lastTrade(atrStop)) * multTP3 + entry_y

position_size = calcPositionSize(entry_y, stop_y, riskPercent, leverage, accountSize)
isHighConviction = close > StrongFilter and trigger == 1 or close < StrongFilter and trigger == 0
tfFormatted = formatTimeframe()

// --------------------------------------------------------------------------------------------------------------------
// ► FIX 1: Variables para congelar las zonas cuando se cierra la señal
// long_zone_right / short_zone_right se fijan al bar_index del cierre
// y se resetean a na cuando arranca una nueva señal
// --------------------------------------------------------------------------------------------------------------------

var int long_zone_right  = na
var int short_zone_right = na

// --------------------------------------------------------------------------------------------------------------------
// LABELS Y LÍNEAS CON ZONAS DE FONDO DINÁMICAS
// --------------------------------------------------------------------------------------------------------------------

var box profitZone1 = na
var box profitZone2 = na
var box profitZone3 = na
var box lossZone = na

var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na

var label entryLabel = na
var label slLabel = na
var label tp1Label = na
var label tp2Label = na
var label tp3Label = na

if enableTpSlAreas
    box.delete(profitZone1[1])
    box.delete(profitZone2[1])
    box.delete(profitZone3[1])
    box.delete(lossZone[1])
    line.delete(entryLine[1])
    line.delete(slLine[1])
    line.delete(tp1Line[1])
    line.delete(tp2Line[1])
    line.delete(tp3Line[1])
    label.delete(entryLabel[1])
    label.delete(slLabel[1])
    label.delete(tp1Label[1])
    label.delete(tp2Label[1])
    label.delete(tp3Label[1])

startBar = bar_index - (trigger ? countBull : countBear)

// ► FIX 1: endBar se congela al bar donde cerró la señal; si sigue abierta, sigue extendiendo
int endBar = na
if trigger == 1
    endBar := na(long_zone_right) ? bar_index + 8 : long_zone_right
else
    endBar := na(short_zone_right) ? bar_index + 8 : short_zone_right

if enableTpSlAreas
    if showZoneBackground
        lossZone := box.new(startBar, entry_y, endBar, stop_y, border_color=color.new(RED_LOSS, 70), border_width=1, bgcolor=color.new(RED_LOSS, 92))

        float firstTP = na
        float secondTP = na
        float thirdTP = na

        if useTP1 and multTP1 != 0
            firstTP := tp1_y
        if useTP2 and multTP2 != 0
            secondTP := na(firstTP) ? tp2_y : tp2_y
        if useTP3 and multTP3 != 0
            thirdTP := tp3_y

        if not na(firstTP) and useTP1 and multTP1 != 0
            profitZone1 := box.new(startBar, entry_y, endBar, tp1_y, border_color=color.new(GREEN_PROFIT, 70), border_width=0, bgcolor=color.new(GREEN_PROFIT, 93))
        else if not na(secondTP) and useTP2 and multTP2 != 0 and (not useTP1 or multTP1 == 0)
            profitZone1 := box.new(startBar, entry_y, endBar, tp2_y, border_color=color.new(GREEN_PROFIT, 70), border_width=0, bgcolor=color.new(GREEN_PROFIT, 93))
        else if not na(thirdTP) and useTP3 and multTP3 != 0 and (not useTP1 or multTP1 == 0) and (not useTP2 or multTP2 == 0)
            profitZone1 := box.new(startBar, entry_y, endBar, tp3_y, border_color=color.new(GREEN_PROFIT, 70), border_width=0, bgcolor=color.new(GREEN_PROFIT, 93))

        if useTP1 and multTP1 != 0 and useTP2 and multTP2 != 0
            profitZone2 := box.new(startBar, tp1_y, endBar, tp2_y, border_color=color.new(GREEN_PROFIT, 60), border_width=0, bgcolor=color.new(GREEN_PROFIT, 90))
        else if useTP1 and multTP1 != 0 and useTP3 and multTP3 != 0 and (not useTP2 or multTP2 == 0)
            profitZone2 := box.new(startBar, tp1_y, endBar, tp3_y, border_color=color.new(GREEN_PROFIT, 60), border_width=0, bgcolor=color.new(GREEN_PROFIT, 90))
        else if useTP2 and multTP2 != 0 and useTP3 and multTP3 != 0 and (not useTP1 or multTP1 == 0)
            profitZone2 := box.new(startBar, tp2_y, endBar, tp3_y, border_color=color.new(GREEN_PROFIT, 60), border_width=0, bgcolor=color.new(GREEN_PROFIT, 90))

        if useTP1 and multTP1 != 0 and useTP2 and multTP2 != 0 and useTP3 and multTP3 != 0
            profitZone3 := box.new(startBar, tp2_y, endBar, tp3_y, border_color=color.new(GREEN_PROFIT, 50), border_width=0, bgcolor=color.new(GREEN_PROFIT, 87))

    entryLine := line.new(startBar, entry_y, endBar, entry_y, xloc.bar_index, extend.none, color.white, line.style_solid, 1)
    slLine    := line.new(startBar, stop_y,  endBar, stop_y,  xloc.bar_index, extend.none, RED_LOSS,    line.style_solid, 1)

    if useTP1 and multTP1 != 0
        tp1Line := line.new(startBar, tp1_y, endBar, tp1_y, xloc.bar_index, extend.none, GREEN_PROFIT, line.style_dashed, 1)
    if useTP2 and multTP2 != 0
        tp2Line := line.new(startBar, tp2_y, endBar, tp2_y, xloc.bar_index, extend.none, GREEN_PROFIT, line.style_dashed, 1)
    if useTP3 and multTP3 != 0
        tp3Line := line.new(startBar, tp3_y, endBar, tp3_y, xloc.bar_index, extend.none, GOLD_TP,      line.style_dashed, 1)

    float sl_percent = math.abs(calcPercentage(stop_y, entry_y))
    float sl_roi     = calcROI(sl_percent, leverage)
    float tp1_percent = calcPercentage(tp1_y, entry_y)
    float tp1_roi     = calcROI(tp1_percent, leverage)
    float tp2_percent = calcPercentage(tp2_y, entry_y)
    float tp2_roi     = calcROI(tp2_percent, leverage)
    float tp3_percent = calcPercentage(tp3_y, entry_y)
    float tp3_roi     = calcROI(tp3_percent, leverage)

    entryLabel := label.new(endBar + 1, entry_y, "▶ ENTRY   " + formatPrice(entry_y), xloc.bar_index, yloc.price, color.new(color.white, 10), label.style_label_left, color.black, size.normal)
    slLabel    := label.new(endBar + 1, stop_y,  "✖ SL   "   + formatPrice(stop_y),  xloc.bar_index, yloc.price, color.new(RED_LOSS, 10),    label.style_label_left, color.white, size.normal)

    if useTP1 and multTP1 != 0
        tp1Label := label.new(endBar + 1, tp1_y, "◉ TP1   " + formatPrice(tp1_y), xloc.bar_index, yloc.price, color.new(GREEN_PROFIT, 10), label.style_label_left, color.black, size.normal)
    if useTP2 and multTP2 != 0
        tp2Label := label.new(endBar + 1, tp2_y, "◉ TP2   " + formatPrice(tp2_y), xloc.bar_index, yloc.price, color.new(GREEN_PROFIT, 10), label.style_label_left, color.black, size.normal)
    if useTP3 and multTP3 != 0
        tp3Label := label.new(endBar + 1, tp3_y, "★ TP3   " + formatPrice(tp3_y), xloc.bar_index, yloc.price, color.new(GOLD_TP, 0),        label.style_label_left, color.black, size.large)

// SEÑALES DE ENTRADA
buy  = showSignals and bull ? label.new(bar_index, low,  isHighConviction ? "LONG\n⚡ HQ"  : "LONG",  xloc.bar_index, yloc.belowbar, isHighConviction ? #00ff00 : #00ffbb, label.style_label_up,   color.rgb(0,0,0), isHighConviction ? size.normal : size.small) : na
sell = showSignals and bear ? label.new(bar_index, high, isHighConviction ? "SHORT\n⚡ HQ" : "SHORT", xloc.bar_index, yloc.abovebar, isHighConviction ? #ff0000 : #ff1100, label.style_label_down, color.rgb(0,0,0), isHighConviction ? size.normal : size.small) : na

// --------------------------------------------------------------------------------------------------------------------
// SISTEMA DE TRACKING
// --------------------------------------------------------------------------------------------------------------------

distancia_y   = math.abs(entry_y - stop_y)
tp1_y_long    = entry_y + distancia_y * multTP1
tp2_y_long    = entry_y + distancia_y * multTP2
tp3_y_long    = entry_y + distancia_y * multTP3
tp1_y_short   = entry_y - distancia_y * multTP1
tp2_y_short   = entry_y - distancia_y * multTP2
tp3_y_short   = entry_y - distancia_y * multTP3

var bool tp1_long_hit        = false
var bool tp2_long_hit        = false
var bool tp3_long_hit        = false
var bool sl_long_hit         = false
var bool signal_closed_long  = false

var bool tp1_short_hit       = false
var bool tp2_short_hit       = false
var bool tp3_short_hit       = false
var bool sl_short_hit        = false
var bool signal_closed_short = false

var int  total_signals       = 0
var int  winning_signals     = 0
var int  losing_signals      = 0
var float total_percent_won  = 0.0
var float total_percent_lost = 0.0
var float total_roi_won      = 0.0
var float total_roi_lost     = 0.0
var float stored_entry       = 0.0
var float stored_stop        = 0.0
var float stored_tp1_long    = 0.0
var float stored_tp2_long    = 0.0
var float stored_tp3_long    = 0.0
var float stored_tp1_short   = 0.0
var float stored_tp2_short   = 0.0
var float stored_tp3_short   = 0.0
var int   last_signal_type   = 0
var int   signal_id          = 0
var string current_signal_id = ""

var float last_tp_roi_long   = 0.0
var float last_tp_roi_short  = 0.0
var string current_signalId  = ""

risk_amount_per_trade = accountSize * (riskPercent / 100)
var float account_balance    = accountSize
var float peak_balance       = accountSize
var float max_drawdown_pct   = 0.0
var float max_drawdown_usd   = 0.0
var int   first_signal_time  = 0

// ── FIX BUG 3: tp1_count/tp2_count/tp3_count declarados aquí ─────────────────
// Se incrementarán SOLO en los bloques de cierre (bull/bear barstate.isconfirmed)
// NO en los bloques de tracking real-time
// ─────────────────────────────────────────────────────────────────────────────
var int tp1_count = 0
var int tp2_count = 0
var int tp3_count = 0
var int sl_count  = 0

// Estado exclusivo del webhook. No altera el tracking, las zonas ni el panel.
var int wh_start_bar = na
varip bool wh_tp1_sent = false
varip bool wh_tp2_sent = false
varip bool wh_tp3_sent = false
varip bool wh_sl_sent = false
varip bool wh_terminal = false
varip float wh_last_tp_roi = 0.0

// Se ejecuta antes de que la señal nueva sustituya los niveles guardados.
// Si una vela histórica contiene SL y TP, se prioriza el SL por prudencia.
if useWebhookJSON and last_signal_type != 0 and not na(wh_start_bar) and bar_index > wh_start_bar and not wh_terminal
    string wh_dir = last_signal_type == 1 ? "LONG" : "SHORT"
    bool wh_stop_touched = last_signal_type == 1 ? low <= stored_stop : high >= stored_stop
    bool wh_tp1_touched = last_signal_type == 1 ? high >= stored_tp1_long : low <= stored_tp1_short
    bool wh_tp2_touched = last_signal_type == 1 ? high >= stored_tp2_long : low <= stored_tp2_short
    bool wh_tp3_touched = last_signal_type == 1 ? high >= stored_tp3_long : low <= stored_tp3_short
    if wh_stop_touched and not wh_sl_sent
        if sendWebhookSL
            alert(buildEventJSON("sl", wh_dir, stored_entry, stored_stop, onzaROI(wh_dir, stored_entry, stored_stop), leverage, current_signalId), alert.freq_all)
        wh_sl_sent := true
        wh_terminal := true
    if not wh_terminal and useTP1 and wh_tp1_touched and not wh_tp1_sent
        float wh_tp1_price = last_signal_type == 1 ? stored_tp1_long : stored_tp1_short
