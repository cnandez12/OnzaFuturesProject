    // TP1 LONG — ► FIX 2: countBull > 0
    if useTP1 and not tp1_long_hit and not signal_closed_long and countBull > 0 and high >= tp1_y_long and countBull < 200
        profit_pct = calcPercentage(tp1_y_long, stored_entry)
        roi_profit = calcROI(profit_pct, leverage)
        display_text = "TP1 +" + str.tostring(roi_profit, "#.##") + "% ROI"
        line.new(bar_index - 2, tp1_y_long, bar_index, tp1_y_long, xloc.bar_index, extend.none, color.new(#ffeb3b, 0), line.style_solid, 2)
        label.new(bar_index - 3, tp1_y_long, display_text, xloc.bar_index, yloc.price, color.new(#ffeb3b, 0), label.style_label_right, color.black, size.small, text.align_right)
        tp1_long_hit      := true
        last_tp_roi_long  := roi_profit
        // ── tp1_count removido de aquí — ahora se incrementa al cierre ───────
        bool is_final_tp1 = not useTP2 and not useTP3
        if is_final_tp1
            signal_closed_long := true
            if na(long_zone_right)
                long_zone_right := bar_index

    // TP2 LONG — ► FIX 2: countBull > 0
    if useTP2 and not tp2_long_hit and not signal_closed_long and countBull > 0 and high >= tp2_y_long and countBull < 200
        profit_pct = calcPercentage(tp2_y_long, stored_entry)
        roi_profit = calcROI(profit_pct, leverage)
        display_text = "TP2 +" + str.tostring(roi_profit, "#.##") + "% ROI"
        line.new(bar_index - 2, tp2_y_long, bar_index, tp2_y_long, xloc.bar_index, extend.none, color.new(#ffeb3b, 0), line.style_solid, 2)
        label.new(bar_index - 3, tp2_y_long, display_text, xloc.bar_index, yloc.price, color.new(#ffeb3b, 0), label.style_label_right, color.black, size.small, text.align_right)
        tp2_long_hit      := true
        last_tp_roi_long  := roi_profit
        // ── tp2_count removido de aquí — ahora se incrementa al cierre ───────
        bool is_final_tp2 = not useTP3
        if is_final_tp2
            signal_closed_long := true
            if na(long_zone_right)
                long_zone_right := bar_index

    // TP3 LONG — ► FIX 2: countBull > 0
    if useTP3 and not tp3_long_hit and not signal_closed_long and countBull > 0 and high >= tp3_y_long and countBull < 200
        profit_pct = calcPercentage(tp3_y_long, stored_entry)
        roi_profit = calcROI(profit_pct, leverage)
        display_text = "TP3 +" + str.tostring(roi_profit, "#.##") + "% ROI"
        line.new(bar_index - 2, tp3_y_long, bar_index, tp3_y_long, xloc.bar_index, extend.none, color.new(#ffeb3b, 0), line.style_solid, 2)
        label.new(bar_index - 3, tp3_y_long, display_text, xloc.bar_index, yloc.price, color.new(#ffeb3b, 0), label.style_label_right, color.black, size.small, text.align_right)
        tp3_long_hit       := true
        last_tp_roi_long   := roi_profit
        // ── tp3_count removido de aquí — ahora se incrementa al cierre ───────
        signal_closed_long := true
        // ► FIX 1: congelar zona al llegar al último TP
        if na(long_zone_right)
            long_zone_right := bar_index

if trigger == 0 and not signal_closed_short
    // SL SHORT — ► FIX 2: countBear > 0
    if not sl_short_hit and countBear > 0 and high >= stop_y and countBear < 200 and not tp1_short_hit and not tp2_short_hit and not tp3_short_hit
        loss_pct = math.abs(calcPercentage(stop_y, stored_entry))
        roi_loss = calcROI(loss_pct, leverage)
        display_text = "SL -" + str.tostring(roi_loss, "#.##") + "% ROI"
        line.new(bar_index - 2, stop_y, bar_index, stop_y, xloc.bar_index, extend.none, color.new(#2196F3, 0), line.style_solid, 2)
        label.new(bar_index - 3, stop_y, display_text, xloc.bar_index, yloc.price, color.new(#2196F3, 0), label.style_label_right, color.white, size.small, text.align_right)
        sl_short_hit         := true
        signal_closed_short  := true
        sl_count += 1
        if na(short_zone_right)
            short_zone_right := bar_index

    if (tp1_short_hit or tp2_short_hit or tp3_short_hit) and high >= stop_y and not signal_closed_short
        signal_closed_short := true
        if na(short_zone_right)
            short_zone_right := bar_index

    // TP1 SHORT — ► FIX 2: countBear > 0
    if useTP1 and not tp1_short_hit and not signal_closed_short and countBear > 0 and low <= tp1_y_short and countBear < 200
        profit_pct = math.abs(calcPercentage(tp1_y_short, stored_entry))
        roi_profit = calcROI(profit_pct, leverage)
        display_text = "TP1 +" + str.tostring(roi_profit, "#.##") + "% ROI"
        line.new(bar_index - 2, tp1_y_short, bar_index, tp1_y_short, xloc.bar_index, extend.none, color.new(#ffeb3b, 0), line.style_solid, 2)
        label.new(bar_index - 3, tp1_y_short, display_text, xloc.bar_index, yloc.price, color.new(#ffeb3b, 0), label.style_label_right, color.black, size.small, text.align_right)
        tp1_short_hit     := true
        last_tp_roi_short := roi_profit
        // ── tp1_count removido de aquí — ahora se incrementa al cierre ───────
        bool is_final_tp1 = not useTP2 and not useTP3
        if is_final_tp1
            signal_closed_short := true
            if na(short_zone_right)
                short_zone_right := bar_index

    // TP2 SHORT — ► FIX 2: countBear > 0
    if useTP2 and not tp2_short_hit and not signal_closed_short and countBear > 0 and low <= tp2_y_short and countBear < 200
        profit_pct = math.abs(calcPercentage(tp2_y_short, stored_entry))
        roi_profit = calcROI(profit_pct, leverage)
        display_text = "TP2 +" + str.tostring(roi_profit, "#.##") + "% ROI"
        line.new(bar_index - 2, tp2_y_short, bar_index, tp2_y_short, xloc.bar_index, extend.none, color.new(#ffeb3b, 0), line.style_solid, 2)
        label.new(bar_index - 3, tp2_y_short, display_text, xloc.bar_index, yloc.price, color.new(#ffeb3b, 0), label.style_label_right, color.black, size.small, text.align_right)
        tp2_short_hit     := true
        last_tp_roi_short := roi_profit
        // ── tp2_count removido de aquí — ahora se incrementa al cierre ───────
        bool is_final_tp2 = not useTP3
        if is_final_tp2
            signal_closed_short := true
            if na(short_zone_right)
                short_zone_right := bar_index

    // TP3 SHORT — ► FIX 2: countBear > 0
    if useTP3 and not tp3_short_hit and not signal_closed_short and countBear > 0 and low <= tp3_y_short and countBear < 200
        profit_pct = math.abs(calcPercentage(tp3_y_short, stored_entry))
        roi_profit = calcROI(profit_pct, leverage)
        display_text = "TP3 +" + str.tostring(roi_profit, "#.##") + "% ROI"
        line.new(bar_index - 2, tp3_y_short, bar_index, tp3_y_short, xloc.bar_index, extend.none, color.new(#ffeb3b, 0), line.style_solid, 2)
        label.new(bar_index - 3, tp3_y_short, display_text, xloc.bar_index, yloc.price, color.new(#ffeb3b, 0), label.style_label_right, color.black, size.small, text.align_right)
        tp3_short_hit        := true
        last_tp_roi_short    := roi_profit
        // ── tp3_count removido de aquí — ahora se incrementa al cierre ───────
        signal_closed_short  := true
        if na(short_zone_right)
            short_zone_right := bar_index

// --------------------------------------------------------------------------------------------------------------------
// P&L EN TIEMPO REAL
// --------------------------------------------------------------------------------------------------------------------

var label realtime_pnl_label = na

if showRealtimePnL and barstate.islast
    if not na(realtime_pnl_label)
        label.delete(realtime_pnl_label)

    if last_signal_type != 0 and stored_entry != 0
        float current_pnl_pct = 0.0
        float current_roi     = 0.0
        color label_color     = color.gray
        string label_text     = ""
        bool show_label       = false

        if last_signal_type == 1
            if not signal_closed_long
                current_pnl_pct := calcPercentage(close, stored_entry)
                current_roi     := calcROI(current_pnl_pct, leverage)
                bool below_last_tp = false
                if tp1_long_hit and close <= stored_tp1_long
                    below_last_tp := true
                else if tp2_long_hit and close <= stored_tp2_long
                    below_last_tp := true
                else if tp3_long_hit and close <= stored_tp3_long
                    below_last_tp := true
                if not below_last_tp
                    show_label := true
                    if current_pnl_pct > 0
                        label_color := color.new(#00E676, 10)
                        label_text  := "📈 +" + str.tostring(current_roi, "#.##") + "%"
                    else if current_pnl_pct < 0
                        label_color := color.new(#FF5252, 10)
                        label_text  := "📉 " + str.tostring(current_roi, "#.##") + "%"
                    else
                        label_color := color.new(#FFD740, 10)
                        label_text  := "➡️ 0.00%"

        else if last_signal_type == -1
            if not signal_closed_short
                current_pnl_pct := calcPercentage(stored_entry, close)
                current_roi     := calcROI(current_pnl_pct, leverage)
                bool below_last_tp = false
                if tp1_short_hit and close >= stored_tp1_short
                    below_last_tp := true
                else if tp2_short_hit and close >= stored_tp2_short
                    below_last_tp := true
                else if tp3_short_hit and close >= stored_tp3_short
                    below_last_tp := true
                if not below_last_tp
                    show_label := true
                    if current_pnl_pct > 0
                        label_color := color.new(#00E676, 10)
                        label_text  := "📈 +" + str.tostring(current_roi, "#.##") + "%"
                    else if current_pnl_pct < 0
                        label_color := color.new(#FF5252, 10)
                        label_text  := "📉 " + str.tostring(current_roi, "#.##") + "%"
                    else
                        label_color := color.new(#FFD740, 10)
                        label_text  := "➡️ 0.00%"

        if show_label and label_text != ""
            realtime_pnl_label := label.new(x=bar_index + 3, y=close, text=label_text, xloc=xloc.bar_index, yloc=yloc.price, color=label_color, style=label.style_label_left, textcolor=color.black, size=size.small, textalign=text.align_left)

// --------------------------------------------------------------------------------------------------------------------
// ALERTAS
// --------------------------------------------------------------------------------------------------------------------

var bool tp1_alerted = false
var bool tp2_alerted = false
var bool tp3_alerted = false
var bool sl_alerted  = false

if bull and barstate.isconfirmed
    sl_roi = calcROI(math.abs(calcPercentage(stop_y, entry_y)), leverage)
    if useWebhookJSON
        float _tp1_roi_json = useTP1 ? onzaROI("LONG", entry_y, tp1_y) : 0.0
        float _tp2_roi_json = useTP2 ? onzaROI("LONG", entry_y, tp2_y) : 0.0
        float _tp3_roi_json = useTP3 ? onzaROI("LONG", entry_y, tp3_y) : 0.0
        string jsonPayload = buildEntryJSON("LONG", entry_y, stop_y, onzaROI("LONG", entry_y, stop_y), tp1_y, _tp1_roi_json, tp2_y, _tp2_roi_json, tp3_y, _tp3_roi_json, leverage, current_signalId)
        alert(jsonPayload, alert.freq_all)
    else
        tpText = ""
        if useTP1
            tp1_roi = calcROI(calcPercentage(tp1_y, entry_y), leverage)
            tpText := tpText + "\n🎯 TP1: " + formatPrice(tp1_y) + " (+" + str.tostring(tp1_roi, "#.##") + "% ROI)"
        if useTP2
            tp2_roi = calcROI(calcPercentage(tp2_y, entry_y), leverage)
            tpText := tpText + "\n🎯 TP2: " + formatPrice(tp2_y) + " (+" + str.tostring(tp2_roi, "#.##") + "% ROI)"
        if useTP3
            tp3_roi = calcROI(calcPercentage(tp3_y, entry_y), leverage)
            tpText := tpText + "\n🎯 TP3: " + formatPrice(tp3_y) + " (+" + str.tostring(tp3_roi, "#.##") + "% ROI)"
        alert("🚀 NUEVA SEÑAL LONG\n━━━━━━━━━━━━━━━━━━━━━━━━\n📊 " + syminfo.ticker + " | " + tfFormatted + " | " + str.tostring(leverage) + "x\n📍 Entrada: " + formatPrice(entry_y) + "\n🛑 Stop Loss: " + formatPrice(stop_y) + " (−" + str.tostring(sl_roi, "#.##") + "% ROI)" + tpText + "\n━━━━━━━━━━━━━━━━━━━━━━━━\n⚡ FB AI CRYPTOFUTURES SCANNER", alert.freq_once_per_bar_close)
    tp1_alerted := false
    tp2_alerted := false
    tp3_alerted := false
    sl_alerted  := false

if bear and barstate.isconfirmed
    sl_roi = calcROI(math.abs(calcPercentage(stop_y, entry_y)), leverage)
    if useWebhookJSON
        float _tp1_roi_json = useTP1 ? onzaROI("SHORT", entry_y, tp1_y) : 0.0
        float _tp2_roi_json = useTP2 ? onzaROI("SHORT", entry_y, tp2_y) : 0.0
        float _tp3_roi_json = useTP3 ? onzaROI("SHORT", entry_y, tp3_y) : 0.0
        string jsonPayload = buildEntryJSON("SHORT", entry_y, stop_y, onzaROI("SHORT", entry_y, stop_y), tp1_y, _tp1_roi_json, tp2_y, _tp2_roi_json, tp3_y, _tp3_roi_json, leverage, current_signalId)
        alert(jsonPayload, alert.freq_all)
    else
        tpText = ""
        if useTP1
            tp1_roi = calcROI(math.abs(calcPercentage(tp1_y, entry_y)), leverage)
            tpText := tpText + "\n🎯 TP1: " + formatPrice(tp1_y) + " (+" + str.tostring(tp1_roi, "#.##") + "% ROI)"
        if useTP2
            tp2_roi = calcROI(math.abs(calcPercentage(tp2_y, entry_y)), leverage)
            tpText := tpText + "\n🎯 TP2: " + formatPrice(tp2_y) + " (+" + str.tostring(tp2_roi, "#.##") + "% ROI)"
        if useTP3
            tp3_roi = calcROI(math.abs(calcPercentage(tp3_y, entry_y)), leverage)
            tpText := tpText + "\n🎯 TP3: " + formatPrice(tp3_y) + " (+" + str.tostring(tp3_roi, "#.##") + "% ROI)"
        alert("📉 NUEVA SEÑAL SHORT\n━━━━━━━━━━━━━━━━━━━━━━━━\n📊 " + syminfo.ticker + " | " + tfFormatted + " | " + str.tostring(leverage) + "x\n📍 Entrada: " + formatPrice(entry_y) + "\n🛑 Stop Loss: " + formatPrice(stop_y) + " (−" + str.tostring(sl_roi, "#.##") + "% ROI)" + tpText + "\n━━━━━━━━━━━━━━━━━━━━━━━━\n⚡ FB AI CRYPTOFUTURES SCANNER", alert.freq_once_per_bar_close)
    tp1_alerted := false
    tp2_alerted := false
    tp3_alerted := false
    sl_alerted  := false

// === ALERTAS TP/SL LONG ===
if not useWebhookJSON and trigger == 1 and not signal_closed_long
    if useTP1 and tp1_long_hit and not tp1_alerted and not signal_closed_long
        profit_pct = calcPercentage(tp1_y_long, stored_entry)
        roi_profit = calcROI(profit_pct, leverage)
        if useWebhookJSON and sendWebhookTP
            alert(buildEventJSON("tp1", "LONG", stored_entry, tp1_y_long, roi_profit, leverage, current_signalId), alert.freq_once_per_bar)
        else if not useWebhookJSON
            alert("✅ TP1 ALCANZADO\n━━━━━━━━━━━━━━━━━━━━━━━━\n📊 " + syminfo.ticker + " | " + tfFormatted + " | LONG\n💰 Ganancia: +" + str.tostring(roi_profit, "#.##") + "% ROI\n📍 Precio: " + formatPrice(tp1_y_long) + "\n━━━━━━━━━━━━━━━━━━━━━━━━\n⚡ FB AI CRYPTOFUTURES SCANNER", alert.freq_once_per_bar)
        tp1_alerted := true
    if useTP2 and tp2_long_hit and not tp2_alerted and not signal_closed_long
        profit_pct = calcPercentage(tp2_y_long, stored_entry)
        roi_profit = calcROI(profit_pct, leverage)
        if useWebhookJSON and sendWebhookTP
            alert(buildEventJSON("tp2", "LONG", stored_entry, tp2_y_long, roi_profit, leverage, current_signalId), alert.freq_once_per_bar)
        else if not useWebhookJSON
            alert("✅ TP2 ALCANZADO\n━━━━━━━━━━━━━━━━━━━━━━━━\n📊 " + syminfo.ticker + " | " + tfFormatted + " | LONG\n💰 Ganancia: +" + str.tostring(roi_profit, "#.##") + "% ROI\n📍 Precio: " + formatPrice(tp2_y_long) + "\n━━━━━━━━━━━━━━━━━━━━━━━━\n⚡ FB AI CRYPTOFUTURES SCANNER", alert.freq_once_per_bar)
        tp2_alerted := true
    if useTP3 and tp3_long_hit and not tp3_alerted and not signal_closed_long
        profit_pct = calcPercentage(tp3_y_long, stored_entry)
        roi_profit = calcROI(profit_pct, leverage)
        if useWebhookJSON and sendWebhookTP
            alert(buildEventJSON("tp3", "LONG", stored_entry, tp3_y_long, roi_profit, leverage, current_signalId), alert.freq_once_per_bar)
        else if not useWebhookJSON
            alert("🏆 TP3 ALCANZADO\n━━━━━━━━━━━━━━━━━━━━━━━━\n📊 " + syminfo.ticker + " | " + tfFormatted + " | LONG\n💰 Ganancia: +" + str.tostring(roi_profit, "#.##") + "% ROI\n📍 Precio: " + formatPrice(tp3_y_long) + "\n━━━━━━━━━━━━━━━━━━━━━━━━\n⚡ FB AI CRYPTOFUTURES SCANNER", alert.freq_once_per_bar)
        tp3_alerted := true
    if sl_long_hit and not sl_alerted
        loss_pct = math.abs(calcPercentage(stop_y, stored_entry))
        roi_loss = calcROI(loss_pct, leverage)
        if useWebhookJSON and sendWebhookSL
            alert(buildEventJSON("sl", "LONG", stored_entry, stop_y, -roi_loss, leverage, current_signalId), alert.freq_once_per_bar)
        else if not useWebhookJSON
            alert("❌ STOP LOSS ALCANZADO\n━━━━━━━━━━━━━━━━━━━━━━━━\n📊 " + syminfo.ticker + " | " + tfFormatted + " | LONG\n💸 Pérdida: −" + str.tostring(roi_loss, "#.##") + "% ROI\n📍 Precio: " + formatPrice(stop_y) + "\n━━━━━━━━━━━━━━━━━━━━━━━━\n⚡ FB AI CRYPTOFUTURES SCANNER", alert.freq_once_per_bar)
        sl_alerted := true

// === ALERTAS TP/SL SHORT ===
if not useWebhookJSON and trigger == 0 and not signal_closed_short
    if useTP1 and tp1_short_hit and not tp1_alerted and not signal_closed_short
        profit_pct = math.abs(calcPercentage(tp1_y_short, stored_entry))
        roi_profit = calcROI(profit_pct, leverage)
