# Copiar a .env para uso local. En Railway se configuran como variables del servicio.
# Ningún valor real va al repositorio.

# --- Base de datos: PostgreSQL exclusiva de este proyecto ---
DATABASE_URL=

# --- Simulación: mismos valores en el servicio web y en `worker.py process` ---
INITIAL_BALANCE=1000
MARGIN_PER_TRADE=20
LEVERAGE=20

# --- Receptor de TradingView: debe coincidir con el campo "API Key" del indicador ---
TRADINGVIEW_API_KEY=

# --- Panel interno: contraseña obligatoria (valor largo y aleatorio) ---
# Sin ella el panel y sus APIs responden 503. Usuario: cualquiera; contraseña: este valor.
DASHBOARD_TOKEN=

# --- Sitio público: hostnames exactos, separados por comas ---
PUBLIC_WEBSITE_HOSTS=trade-onzafutures.up.railway.app
# Orígenes externos autorizados a leer las APIs del panel (normalmente vacío).
ALLOWED_ORIGINS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
DESTINATION_CHANNEL_ID=
# Canal Free. Si se omite, se usa el canal Free por defecto definido en telegram_channels.py;
# un valor vacío lo desactiva.
# FREE_CHANNEL_ID=
# Enlace de la app al pie de los mensajes. Sin valor, el pie se publica sin enlace.
# TELEGRAM_APP_URL=
# Símbolos que nunca se ofrecen como señal Free completa, separados por comas.
# ONZA_FREE_BLACKLIST=

# --- VORZA: ver VORZA_DEPLOY.md. Mismo VORZA_ENABLED en el servicio web y en el worker ---
VORZA_ENABLED=false
VORZA_SIGNAL_KEY=
VORZA_COMPANY=VORZA
VORZA_PROVIDER_ID=1
VORZA_EXPIRES_MINUTES=20
VORZA_ORDER_TYPE=market
VORZA_RATE_PER_MINUTE=10
VORZA_NOTE=Señal del scanner

PORT=5000
