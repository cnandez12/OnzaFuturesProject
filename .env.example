# Usar una base PostgreSQL NUEVA. setup_db.py rechaza una base del proyecto anterior.
DATABASE_URL=
INITIAL_BALANCE=1000
MARGIN_PER_TRADE=20
LEVERAGE=20

# La API key configurada en el Pine debe coincidir con TRADINGVIEW_API_KEY.
# ONZA_API_KEY es la credencial del envío al endpoint que ya usa el proyecto original.
TRADINGVIEW_API_KEY=
ONZA_API_KEY=
ONZA_WEBHOOK_URL=https://api.onza.tech/api/v1/webhooks/signal?source=TradingView

# Bot administrador del canal privado nuevo. Ningún canal anterior se usa aquí.
TELEGRAM_BOT_TOKEN=
DESTINATION_CHANNEL_ID=

ALLOWED_ORIGINS=
PORT=5000
