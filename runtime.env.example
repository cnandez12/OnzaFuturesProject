# Current runtime sample; no retired outbound credentials.
# Usar una base PostgreSQL NUEVA. setup_db.py rechaza una base del proyecto anterior.
DATABASE_URL=
INITIAL_BALANCE=1000
MARGIN_PER_TRADE=20
LEVERAGE=20

# La API key configurada en el Pine debe coincidir con TRADINGVIEW_API_KEY.
TRADINGVIEW_API_KEY=

# Bot administrador del canal privado nuevo. Ningún canal anterior se usa aquí.
TELEGRAM_BOT_TOKEN=
DESTINATION_CHANNEL_ID=

ALLOWED_ORIGINS=
PORT=5000

# VORZA remains off until acceptance testing.
VORZA_ENABLED=false
VORZA_SIGNAL_KEY=
VORZA_PROVIDER_ID=1
VORZA_COMPANY=VORZA
VORZA_RATE_PER_MINUTE=10
