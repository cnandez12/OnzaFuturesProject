# ── Base de datos (misma que usa el bot) ──────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# ── Config ──────────────────────────────────────────────────────
INITIAL_BALANCE=1000
MARGIN_PER_TRADE=20
LEVERAGE=20

# ── Token de protección (opcional, deja vacío para acceso libre) ──────────────
# DASHBOARD_TOKEN=tu_token_secreto

# ── Puerto local ──────────────────────────────────────────────────────────────
PORT=5000
